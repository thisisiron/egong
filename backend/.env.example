# 참고용 예시입니다 — 실제로 채워 쓰는 템플릿이 아닙니다.
#
# backend/.env는 이제 손으로 만들지 않습니다. 루트 .env를 채운 뒤
# `pnpm env:sync`를 실행하면 이 파일이 자동 생성됩니다 (scripts/env-sync.mjs).
# 아래는 env:sync가 만드는 결과물의 형태를 보여주는 예시일 뿐입니다.
#
# 스크립트 없이 수동으로 구성하려면 이 파일을 backend/.env로 복사해 값을 채우세요
# (동작은 하지만, 그러면 루트/프론트와 값이 다시 따로 놀 수 있습니다).

SUPABASE_URL=https://__set_in_local_env__.supabase.co
# 신형 `sb_secret_` 키는 이 프로젝트에서 401을 반환한다 — legacy service_role JWT를 쓸 것.
# 자세한 배경은 루트 .env.example의 SUPABASE_SECRET_KEY 주석 참고.
SUPABASE_SECRET_KEY=eyJ__legacy_service_role_jwt__
SUPABASE_PUBLISHABLE_KEY=sb_publishable___set_in_local_env__
NTS_API_KEY=__from_data_go_kr__
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# scripts/seed_dev_accounts.py 가 사용하는 시드 계정 비밀번호. 필수 — 기본값 없음
# (미설정 시 계정 생성/재설정 시점에 에러로 중단됨). 직접 강한 값으로 채울 것.
# 이 저장소는 공개돼 있고 시드 계정은 실제 Supabase 프로젝트에 존재하므로,
# 여기에 동작하는 비밀번호를 적으면 그대로 로그인 가능한 자격증명이 공개된다.
SEED_PASSWORD=__set_a_strong_password_locally__

# RLS 권한 경계 테스트(`pnpm test:rls`) 전용 — Postgres 직결 URL.
# tests/rls/conftest.py가 이 URL로 붙어 SET LOCAL role='authenticated' + JWT 클레임을
# 걸고 사용자 시점을 흉내낸다. 없으면 스위트가 skip이 아니라 fail한다(거짓 통과 방지).
# 값: Supabase 대시보드 → Settings → Database → Connection string → Session pooler
DATABASE_URL=postgresql://postgres.__set_in_local_env__:__password__@__region__.pooler.supabase.com:5432/postgres
