# 참고용 예시입니다 — 실제로 채워 쓰는 템플릿이 아닙니다.
#
# frontend/.env.local은 이제 손으로 만들지 않습니다. 루트 .env를 채운 뒤
# `pnpm env:sync`를 실행하면 이 파일이 자동 생성됩니다 (scripts/env-sync.mjs).
# 아래는 env:sync가 만드는 결과물의 형태를 보여주는 예시일 뿐입니다.
#
# 스크립트 없이 수동으로 구성하려면 이 파일을 frontend/.env.local로 복사해 값을 채우세요
# (동작은 하지만, 그러면 루트/백엔드와 값이 다시 따로 놀 수 있습니다).

# Supabase (cloud — get values from https://supabase.com/dashboard → Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://__set_in_local_env__.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable___set_in_local_env__

# FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# dev 퀵 로그인 (임시 기능 — 로컬 전용, 프로덕션에는 절대 설정하지 말 것)
# 켜려면 아래 줄의 주석을 해제할 것 — 그러면 /login 에 역할별 원클릭 로그인 배너가 뜬다.
# NEXT_PUBLIC_ 접두사를 붙이지 말 것 — 서버 전용이어야 한다.
# DEV_LOGIN_ENABLED=1
# 시드 비밀번호를 바꾼 경우에만 설정 (기본값 ***REMOVED*** 로 충분)
# DEV_LOGIN_PASSWORD=***REMOVED***
