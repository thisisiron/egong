# 루트 .env — 이 리포의 환경변수 "유일한 소스".
#
# 여기 하나만 채우면 된다. `pnpm env:sync`가 이 값들을 읽어
# backend/.env, frontend/.env.local을 자동 생성한다 (스크립트: scripts/env-sync.mjs).
# 두 파일을 손으로 고치지 말 것 — 다시 sync하면 덮어써진다.
#
# 사용법:
#   cp .env.example .env   # 값 채우기
#   pnpm env:sync           # backend/.env, frontend/.env.local 생성

# ============================================================
# 공유 — 백엔드(FastAPI)와 프론트(Next.js) 양쪽에 필요
# 출처: Supabase 대시보드 → Settings → API Keys
# ============================================================
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# secret 키 — 절대 프론트로 넘어가면 안 됨. env-sync.mjs가 이를 구조적으로 막는다
# (프론트 매핑 테이블에 SECRET 패턴이 들어가면 스크립트가 에러로 멈춘다).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# db:types, Supabase CLI 링크 전용. 어느 앱의 .env에도 복사되지 않는다 — 셸에 직접
# export해야 pnpm db:types가 동작한다 (README 참고).
SUPABASE_PROJECT_REF=<your-ref>

# ============================================================
# 백엔드 전용 (env-sync.mjs → backend/.env)
# ============================================================
# 국세청 data.go.kr 오픈API 사업자등록정보 진위확인 서비스 일반 인증키 (decoded). 필수 —
# backend/src/core/config.py의 Settings에 기본값 없이 선언돼 있어 없으면 서버가 기동하지 않음.
NTS_API_KEY=<data.go.kr 발급 키>

# 선택 — 없으면 env-sync.mjs가 아래 기본값으로 채운다.
# ALLOWED_ORIGINS=http://localhost:3000
# ENVIRONMENT=development

# RLS 테스트(pnpm test:rls, -m rls)에서만 필요한 Postgres 직결 DSN.
# Supabase 대시보드 → Settings → Database → Connection string → Session pooler.
# 없으면 backend/.env에서 그냥 빠지고, `pnpm test:rls`가 그 자리에서 실패로 안내한다.
# DATABASE_URL=postgresql://postgres.<your-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 시드 계정(@egong.test)에 쓰는 비밀번호. 없으면 env-sync.mjs가 기본값 ***REMOVED***로 채운다
# (backend/scripts/seed/world.py의 기본값과 동일 — 바꿀 때만 여기 설정).
# SEED_PASSWORD=***REMOVED***

# ============================================================
# 프론트 전용 (env-sync.mjs → frontend/.env.local, NEXT_PUBLIC_ 접두사로 변환)
# ============================================================
# 선택 — 없으면 env-sync.mjs가 http://localhost:8000으로 채운다.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# dev 퀵 로그인 (로컬 전용, 프로덕션에는 절대 설정하지 말 것).
# 켜면 /login에 역할별 원클릭 로그인 배너가 뜬다.
# DEV_LOGIN_ENABLED=1
# DEV_LOGIN_PASSWORD=***REMOVED***  # SEED_PASSWORD를 바꾼 경우에만 설정
